{
  "name": "ilovfyu-blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "blog:doctor": "node --env-file-if-exists=.env scripts/siyuan-sync.mjs --doctor",
    "blog:sync": "node --env-file-if-exists=.env scripts/siyuan-sync.mjs",
    "blog:preview": "npm run blog:sync && npm run docs:dev -- --host 127.0.0.1 --port 8092",
    "blog:publish": "node --env-file-if-exists=.env scripts/blog-publish.mjs",
    "test:publishing": "node --test tests/publishing.test.mjs",
    "test:knowledge": "node --test tests/knowledge.test.mjs tests/knowledge-path.test.mjs tests/topic-rendering.test.mjs tests/article-search.test.mjs",
    "test:reading": "node --test tests/article-preview.test.mjs tests/reading-progress.test.mjs",
    "test:rendering": "node --test tests/rendering.test.mjs tests/project-rendering.test.mjs"
  },
  "devDependencies": {
    "@lucide/vue": "^1.28.0",
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "katex": "^0.17.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.34",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-plume": "1.0.0-rc.204"
  }
}
