GISCUS_REPO_ID=
GISCUS_CATEGORY_ID=
GISCUS_CATEGORY=Announcements

# SiYuan desktop kernel. Token is optional if local API authentication is disabled.
SIYUAN_URL=http://127.0.0.1:6806
SIYUAN_TOKEN=

# Optional overrides for local production builds; Actions uses actual Pages metadata.
# SITE_HOSTNAME=https://ilovfyu.github.io
# PAGES_BASE_PATH=/ilovfyu-blog

# Public Worker address only. Never put DEEPSEEK_API_KEY in a frontend/build variable.
# BLOG_AI_ENDPOINT=https://ilovfyu-knowledge-assistant.YOUR-SUBDOMAIN.workers.dev/chat
