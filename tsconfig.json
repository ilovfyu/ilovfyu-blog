{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Intl"],
    "types": ["node", "vite/client", "@vuepress/client/types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["docs/.vuepress/**/*.ts", "docs/.vuepress/**/*.vue", "workers/**/*.ts"],
  "exclude": ["node_modules", "docs/.vuepress/.temp", "docs/.vuepress/.cache", "docs/.vuepress/dist"]
}
